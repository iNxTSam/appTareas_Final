APP_NAME="App Tareas API"
APP_ENV=production
# Genera la clave con: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Bogota
APP_URL=http://backend:8000
FRONTEND_URL=http://157.137.210.124

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=bd
DB_USERNAME=postgres
# Cambia esta clave en el .env real; no la subas al repositorio.
DB_PASSWORD=cambia_esta_clave

# Correo. Sin esto, los enlaces de recuperacion se escriben en el log y no
# llegan al usuario. Usa una contrasena de aplicacion de Gmail (requiere 2FA),
# no la contrasena normal de la cuenta.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=app.tareas.noreply@gmail.com
MAIL_PASSWORD=cambia_esta_clave_de_aplicacion
MAIL_FROM_ADDRESS="app.tareas.noreply@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
