APP_NAME="App Tareas"
APP_ENV=production
# Genera la clave con: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Bogota
APP_URL=http://157.137.210.124

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=bd
DB_USERNAME=postgres
# Cambia esta clave en el .env real; no la subas al repositorio.
DB_PASSWORD=cambia_esta_clave

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
